generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int      @id @default(1)
  name        String
  headline    String
  avatarUrl   String?
  summary     String
  resumeUrl   String?
  email       String
  githubUrl   String?
  linkedinUrl String?
  themeColor  String   @default("rose")
  updatedAt   DateTime @updatedAt
}

model Skill {
  id       Int     @id @default(autoincrement())
  name     String
  category String?
  order    Int     @default(0)
}

model SkillCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique
  order Int    @default(0)
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String
  imageUrls   String   @default("[]")
  techStack   String   @default("")
  projectUrl  String?
  sourceUrl   String?
  startDate   String?
  endDate     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id             Int      @id @default(autoincrement())
  role           String
  company        String
  logoUrl        String?
  employmentType String?
  locationType   String?
  startDate      String?
  endDate        String?
  description    String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement())
  degree      String
  institution String
  logoUrl     String?
  startDate   String?
  endDate     String?
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id               Int       @id @default(autoincrement())
  title            String
  issuer           String
  imageUrl         String
  certificationUrl String?
  issuedAt         DateTime?
  order            Int       @default(0)
}

model AdminSecurity {
  id            Int       @id @default(1)
  totpSecret    String?
  totpEnabledAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}
