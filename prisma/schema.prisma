generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int      @id @default(1)
  name        String
  headline    String
  avatarUrl   String?
  summary     String
  resumeUrl   String?
  email       String
  phone       String?
  location    String?
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  themeColor  String   @default("rose")
  updatedAt   DateTime @updatedAt
}

model Skill {
  id       Int     @id @default(autoincrement())
  name     String
  category String?
  order    Int     @default(0)
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String
  imageUrls   String   @default("[]")
  techStack   String   @default("")
  projectUrl  String?
  sourceUrl   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          Int      @id @default(autoincrement())
  role        String
  company     String
  logoUrl     String?
  location    String?
  startDate   String?
  endDate     String?
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement())
  degree      String
  institution String
  logoUrl     String?
  location    String?
  startDate   String?
  endDate     String?
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id            Int       @id @default(autoincrement())
  title         String
  issuer        String
  imageUrl      String
  credentialUrl String?
  issuedAt      DateTime?
  order         Int       @default(0)
}
